# Copy to .env locally. Never put real credentials in this template or YAML.
# Tracer LLM and embeddings.
OPENAI_API_KEY=
OPENAI_API_KEY_EMB=
# Comma-separated blockchain explorer keys.
SPIDER_API_KEYS=
ETHERSCAN_API_KEY=
# Optional comma-separated RPC URLs, which may contain provider credentials.
# If empty, the public RPC endpoint in project_settings.yaml is used.
ETHEREUM_RPC_URLS=
# Evidence report generation.
API_KEY=
# Optional report evaluation; all values remain local.
DS_API_KEY=
QWEN_API_KEY=
N1N_API_KEY=
SF_API_KEY=
# Optional local BlockchainSpider checkout (not included in this repository).
# BLOCKCHAIN_SPIDER_DIR=external/BlockchainSpider
